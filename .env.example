# ======================================================================
# NEUROQUANT — Environment Configuration
# Educational paper-trading platform. Free services only.
#
# SETUP (takes ~30 seconds):
#   cp .env.example .env
#   # Edit DATABASE_URL if you want PostgreSQL instead of SQLite
#   # All broker/API keys below are OPTIONAL — the app runs without them
#
# GENERATE JWT KEYS (required for auth to work):
#   mkdir keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
#
# GENERATE FERNET KEY (for field-level encryption):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ======================================================================

# ─── Application ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=NeuroQuant
API_V1_PREFIX=/api/v1

# ─── Database — SQLite for local dev; switch to Postgres for prod ────
# SQLite (no server needed, works out of the box):
DATABASE_URL=sqlite+aiosqlite:///./backend/dev.db
SYNC_DATABASE_URL=sqlite:///./backend/dev.db

# PostgreSQL (recommended for production, Docker Compose provides this):
# DATABASE_URL=postgresql+asyncpg://neuroquant:changeme@localhost:5432/neuroquant_db
# SYNC_DATABASE_URL=postgresql+psycopg2://neuroquant:changeme@localhost:5432/neuroquant_db

# Postgres Docker credentials (only needed when docker-compose.yml is used):
POSTGRES_USER=neuroquant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=neuroquant_db

# ─── Redis 7 ─────────────────────────────────────────────────────────
# Docker Compose provides Redis automatically:
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_CACHE_TTL=300
RATE_LIMIT_ENABLED=false

# ─── Security / JWT (RS256) ──────────────────────────────────────────
# Generate keys with the commands at the top of this file:
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for field-level encryption (generate with command above):
FIELD_ENCRYPTION_KEY=GENERATE_ME_see_instructions_above
ENCRYPTION_ENABLED=false

# General secret key (used for CSRF etc.):
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Frontend (Next.js public env vars) ──────────────────────────────
# These are exposed to the browser — do NOT put secrets here:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ─── Free Market Data APIs ───────────────────────────────────────────
# yfinance: no key needed (used automatically)
# NSE India public JSON: no key needed (used automatically)
# Stooq: no key needed (used automatically)

# Alpha Vantage — free tier: 25 requests/day (leave blank = skip):
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED (Federal Reserve Economic Data) — free key required for macro data:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CoinGecko — no key needed for free tier (rate limited):
COINGECKO_API_KEY=

# ─── Optional Broker APIs (app runs fully without these) ─────────────
# Angel One SmartAPI — free with a free account:
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_CLIENT_SECRET=
ANGEL_ONE_TOTP_SECRET=

# Upstox — free with a free account:
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
UPSTOX_MAX_ORDER_VALUE=10000.0

# ─── Email / Notifications ────────────────────────────────────────────
# Gmail app-password (free) or Brevo free tier — both optional:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@neuroquant.local
ALERT_EMAIL_ENABLED=false

# ─── Payments — Razorpay Test Mode (free, no company required) ───────
# https://razorpay.com/docs/api/  →  Settings → API Keys → Test Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# ─── ML / Model Settings ─────────────────────────────────────────────
MODEL_CHECKPOINT_DIR=./data/models
ENABLE_GPU=false
MLFLOW_TRACKING_URI=http://localhost:5000

# HuggingFace token — only needed to download FinBERT on first run:
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# ─── Safety flags ────────────────────────────────────────────────────
# Paper trading only — never route live orders
LIVE_EXECUTION_CONFIRMED=OFF
PAPER_TRADING_MODE=true

# ─── Observability (optional) ────────────────────────────────────────
SENTRY_DSN=
