FROM node:20-slim AS builder
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Install dependencies and build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @neuroquant/web build

FROM node:20-slim AS runner
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app
ENV NODE_ENV=production

# Copy built app
COPY --from=builder /app /app

EXPOSE 3000

CMD ["pnpm", "--filter", "@neuroquant/web", "start"]
