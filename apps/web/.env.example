# Supabase Public Keys (Supabase dashboard -> Project Settings -> API).
# Required: the app cannot sign in without these (used in
# src/lib/supabase/client.ts, server.ts, and middleware.ts).
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_REGION=

# Supabase Server / Edge runtime keys (optional, for server functions)
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<project_ref>.supabase.co/auth/v1/.well-known/jwks.json

# Database Connection (Supabase PostgreSQL via Supavisor pooler)
DATABASE_URL="postgresql://postgres.<project_ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project_ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"


# Backend API origin (bare origin, no /api/v1 suffix -- the client code
# appends /api/v1 itself). Point this at wherever the FastAPI backend
# (backend/) is actually running.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket origin for live price/signal feeds. Optional: if omitted it is
# derived from NEXT_PUBLIC_API_URL (http -> ws, https -> wss).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Razorpay publishable key (safe for the browser); used only to open the
# Razorpay Checkout widget. Payment success is always verified server-side.
# Optional: leave blank until you wire up real payments. Must match the
# RAZORPAY_KEY_ID configured on the backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
