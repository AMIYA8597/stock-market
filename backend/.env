ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Supabase Postgres via the Session/Transaction Pooler (IPv4-compatible --
# the "Direct connection" hostname Supabase shows is IPv6-only and won't
# resolve on IPv4-only networks). Password below is URL-encoded: the
# literal "@" in "-Amiya@8597" is written as %40 since "@" is a URL
# delimiter and would otherwise split the password from the host.
DATABASE_URL=postgresql+asyncpg://postgres.avizvhsyqyrtyszgfjiv:-Amiya%408597@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
MIGRATIONS_DATABASE_URL=postgresql+psycopg2://postgres.avizvhsyqyrtyszgfjiv:-Amiya%408597@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
INGEST_DATABASE_URL=postgresql+asyncpg://postgres.avizvhsyqyrtyszgfjiv:-Amiya%408597@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# DATABASE_URL/INGEST_DATABASE_URL use the transaction pooler (6543), which
# doesn't support server-side prepared statements -- this must stay
# "transaction" to match (see app/database/connection.py).
DB_POOL_MODE=transaction

# --- Previous values (local SQLite, no external DB needed) -- kept, not
# deleted. Uncomment these 3 and comment out the Postgres block above to
# go back to local-only dev with no Supabase database dependency. ---
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# MIGRATIONS_DATABASE_URL=sqlite:///./dev.db
# INGEST_DATABASE_URL=sqlite+aiosqlite:///./dev.db

REDIS_URL=redis://localhost:6379/0

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Supabase Auth. JWT verification uses JWKS (fetched automatically from
# SUPABASE_URL) so SUPABASE_JWT_SECRET is not needed for a new project.
SUPABASE_URL=https://avizvhsyqyrtyszgfjiv.supabase.co
SUPABASE_SECRET_KEY=sb_secret_mZ1ELWgcuJyxrAh7t7g1AQ__uZo--_v
