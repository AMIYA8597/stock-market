# ======================================================================
# NEUROQUANT BACKEND — Environment Configuration
#
# This is the file the backend actually reads (app/core/config.py loads
# `backend/.env`). The repo root also has a .env.example left over from an
# earlier design (local RSA JWT keys + SQLite-first) -- that one is NOT
# read by the backend anymore. Auth and the primary database are now
# Supabase-based. Ignore the root file; use this one.
# ======================================================================

# ─── Application ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME=NeuroQuant
API_V1_PREFIX=/api/v1

# ─── Database ──────────────────────────────────────────────────────────
# Real Supabase Postgres project, via the Transaction/Session pooler
# (region: ap-northeast-1 / Tokyo). Direct connection (db.<ref>.supabase.co)
# is IPv6-only on this project's plan; the pooler is IPv4 compatible.
DATABASE_URL=postgresql+asyncpg://postgres.avizvhsyqyrtyszgfjiv:-Amiya%408597@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres.avizvhsyqyrtyszgfjiv:-Amiya%408597@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
INGEST_DATABASE_URL=postgresql+asyncpg://postgres.avizvhsyqyrtyszgfjiv:-Amiya%408597@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Supabase / Authentication (required for login) ───────────────────
SUPABASE_URL=https://avizvhsyqyrtyszgfjiv.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=sb_secret_mZ1ELWgcuJyxrAh7t7g1AQ__uZo--_v

# ─── CORS ─────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── Frontend URL ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Free Market Data (no key needed) ──────────────────────────────────
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
NEWSAPI_KEY=
COINGECKO_API_KEY=
FINNHUB_API_KEY=

# ─── Optional Broker APIs ───────────────────────────────────────────────
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_CLIENT_SECRET=
ANGEL_ONE_TOTP_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
UPSTOX_MAX_ORDER_VALUE=10000.0

# ─── Email / Notifications ─────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@neuroquant.local
ALERT_EMAIL_ENABLED=false

# ─── Payments — Razorpay Test Mode ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_TK1243RLJnEnWy
RAZORPAY_KEY_SECRET=GgDOsDH70iQUWNt4F5DNjakU
RAZORPAY_WEBHOOK_SECRET=

# ─── ML / Model Settings ────────────────────────────────────────────────
MODEL_CHECKPOINT_DIR=./data/models
ENABLE_GPU=false
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Observability (optional) ──────────────────────────────────────────
SENTRY_DSN=

# ─── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ─── Database Connection Pool ───────────────────────────────────────────
DB_POOL_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
REDIS_MAX_CONNECTIONS=50

# ─── Auth / Password Policy ─────────────────────────────────────────────
TOKEN_BLACKLIST_ENABLED=true
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HASH_ALGORITHM=argon2
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FIELD_ENCRYPTION_KEY=
ENCRYPTION_ENABLED=false

# ─── CORS / Security Headers ─────────────────────────────────────────────
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,Idempotency-Key,Stripe-Signature
ALLOWED_HOSTS=
SECURITY_CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ─── ML Training / Feature Engineering ──────────────────────────────────
INFERENCE_BATCH_SIZE=32
TRAINING_BATCH_SIZE=64
SEQUENCE_LENGTH=60
FORECAST_HORIZON=5
LIVE_DATA_PROVIDER=yfinance
LIVE_DATA_YFINANCE_RATE_LIMIT=5
LIVE_DATA_ALPHA_VANTAGE_RATE_LIMIT=5
FEATURE_NORMALIZATION_METHOD=robust
FEATURE_CACHE_TTL_HOURS=24
ONLINE_LEARNING_ENABLED=true
DRIFT_DETECTION_ENABLED=true
DRIFT_DETECTION_ALPHA=0.002
RETRAIN_MIN_INTERVAL_HOURS=24
RETRAIN_SAMPLE_SIZE=500

# ─── Backtesting / Celery ────────────────────────────────────────────────
BACKTEST_CACHE_DIR=./data/backtest_cache
BACKTEST_MAX_WORKERS=4
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_HARD_TIME_LIMIT=900

# ─── Monitoring ───────────────────────────────────────────────────────────
MLFLOW_EXPERIMENT_NAME=neuroquant-prod
ENABLE_PROMETHEUS_METRICS=true
METRICS_COLLECTION_INTERVAL_SECONDS=60

# ─── Frontend / WebSocket URLs ──────────────────────────────────────────
FRONTEND_STAGING_URL=https://staging.neuroquant.dev
FRONTEND_PRODUCTION_URL=https://app.neuroquant.com
WEBSOCKET_URL=ws://localhost:8000/ws
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5

# ─── Rate Limiting (additional tiers) ────────────────────────────────────
DEFAULT_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=10/minute
PREMIUM_RATE_LIMIT=1000/minute

# ─── Misc ─────────────────────────────────────────────────────────────────
MAX_TRACKED_SYMBOLS=100
BATCH_SIZE=20







































# # ======================================================================
# # NEUROQUANT BACKEND — Environment Configuration
# #
# # This is the file the backend actually reads (app/core/config.py loads
# # `backend/.env`). The repo root also has a .env.example left over from an
# # earlier design (local RSA JWT keys + SQLite-first) -- that one is NOT
# # read by the backend anymore. Auth and the primary database are now
# # Supabase-based. Ignore the root file; use this one.
# #
# # SETUP:
# #   cd backend
# #   cp .env.example .env
# #   # then fill in the values below
# #
# # Only 4 variables are required to get the API booting and serving paper
# # trading / market data with no external accounts at all: ENVIRONMENT,
# # DATABASE_URL, REDIS_URL, BACKEND_CORS_ORIGINS (all have working local
# # defaults below). Everything under "Supabase" is required for login to
# # work. Everything below that is optional -- missing keys degrade a
# # specific feature gracefully rather than crashing the app.
# # ======================================================================

# # ─── Application ─────────────────────────────────────────────────────
# ENVIRONMENT=development
# DEBUG=true
# LOG_LEVEL=INFO
# PROJECT_NAME=NeuroQuant
# API_V1_PREFIX=/api/v1

# # ─── Database ──────────────────────────────────────────────────────────
# # Quickest path (no server to install): SQLite, works out of the box.
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# MIGRATIONS_DATABASE_URL=sqlite:///./dev.db
# INGEST_DATABASE_URL=sqlite+aiosqlite:///./dev.db

# # Production path: a Supabase Postgres project (Project Settings -> Database
# # -> Connection string). Use the "Transaction" pooler (port 6543) for the
# # async runtime URL and the direct/session connection (port 5432) for
# # migrations. Replace <role>.<project_ref> and <password>:
# # DATABASE_URL=postgresql+asyncpg://<role>.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# # MIGRATIONS_DATABASE_URL=postgresql+psycopg://<role>.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# # INGEST_DATABASE_URL=postgresql+asyncpg://<role>.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# # DB_SSL_REQUIRED defaults to true and only takes effect for postgresql://
# # URLs (Supabase requires SSL) -- it's a no-op for the SQLite URL above,
# # so there's nothing to set while using SQLite.

# # ─── Redis ────────────────────────────────────────────────────────────
# # Optional in development: if unreachable the app falls back to an
# # in-memory cache/pubsub automatically (you'll see a warning in the logs,
# # nothing breaks). Install Redis locally or run
# # `docker compose -f docker-compose.dev.yml up redis` for real caching,
# # rate limiting and multi-process WebSocket fan-out.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# # ─── Supabase / Authentication (required for login) ───────────────────
# # Supabase dashboard -> Project Settings -> API.
# SUPABASE_URL=https://<project_ref>.supabase.co
# # "JWT Secret" on the same page -- used to verify tokens the frontend sends.
# SUPABASE_JWT_SECRET=
# # "service_role" secret key (same page). Grants full DB access, bypassing
# # RLS -- back-end only, never expose this to the browser or commit it.
# SUPABASE_SECRET_KEY=

# # ─── CORS ─────────────────────────────────────────────────────────────
# # Origins allowed to call this API. Add your deployed frontend URL here
# # too once you have one (comma-separated or JSON array).
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# # ─── Frontend URL (used for links in emails, CORS-adjacent redirects) ──
# FRONTEND_URL=http://localhost:3000

# # ─── Free Market Data (no key needed) ──────────────────────────────────
# # yfinance, NSE India public JSON, Stooq are used automatically with no
# # key. The keys below add extra/backup data sources -- all optional.

# # Alpha Vantage — free tier, 25 requests/day:
# # https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=

# # FRED (Federal Reserve Economic Data) — free key, needed for macro data:
# # https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# # NewsAPI — free tier, needed for financial news sentiment features:
# # https://newsapi.org/register
# NEWSAPI_KEY=

# # CoinGecko — free tier works without a key; add one only if you hit
# # rate limits: https://www.coingecko.com/en/api/pricing
# COINGECKO_API_KEY=

# # Finnhub — free tier, intraday/company data:
# # https://finnhub.io/register
# FINNHUB_API_KEY=

# # ─── Optional Broker APIs (paper trading works fully without these) ───
# # Angel One SmartAPI — free account: https://smartapi.angelone.in/
# ANGEL_ONE_CLIENT_ID=
# ANGEL_ONE_CLIENT_SECRET=
# ANGEL_ONE_TOTP_SECRET=

# # Upstox — free developer account: https://upstox.com/developer/apps
# # Required in production (see validate_production_keys in config.py) if
# # you intend to route real broker orders; leave blank for paper trading.
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
# UPSTOX_MAX_ORDER_VALUE=10000.0

# # ─── Email / Notifications ─────────────────────────────────────────────
# # SendGrid — free tier (100 emails/day): https://signup.sendgrid.com/
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=alerts@neuroquant.local
# ALERT_EMAIL_ENABLED=false

# # ─── Payments — Razorpay Test Mode (free, no company required) ────────
# # https://dashboard.razorpay.com/ -> Settings -> API Keys -> Generate Test Key
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_me
# # Webhook secret you set when creating the webhook in the Razorpay
# # dashboard (Settings -> Webhooks). Only needed if you wire up webhooks.
# PAYMENT_WEBHOOK_SECRET=

# # ─── ML / Model Settings ────────────────────────────────────────────────
# MODEL_CHECKPOINT_DIR=./data/models
# ENABLE_GPU=false
# MLFLOW_TRACKING_URI=http://localhost:5000

# # ─── Observability (optional) ──────────────────────────────────────────
# # Sentry error tracking: https://sentry.io/ (free tier available).
# SENTRY_DSN=

# # ─── Rate Limiting ──────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
