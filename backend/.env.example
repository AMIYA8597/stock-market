# Supabase connection
# Use transaction mode (port 6543) for API operations (SQLAlchemy)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://<role>.<project_ref>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
INGEST_DATABASE_URL=postgresql+asyncpg://<role>.<project_ref>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Environment settings
ENVIRONMENT=development

