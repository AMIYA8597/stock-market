# Backend Environment Variables
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database URLs
# For Supavisor pooler, use port 5432 (session) or 6543 (transaction).
# Usernames must be in format <role>.<project_ref> (e.g. nq_api.itnwhuvffxjqstronryp).
# Always require SSL: ?ssl=require (asyncpg) or ?sslmode=require (psycopg2).
DATABASE_URL=postgresql+asyncpg://nq_api.<ref>:<password>@<pooler_host>:5432/postgres?ssl=require
MIGRATIONS_DATABASE_URL=postgresql+psycopg2://nq_migrator.<ref>:<password>@<pooler_host>:5432/postgres?sslmode=require
INGEST_DATABASE_URL=postgresql+asyncpg://nq_ingest.<ref>:<password>@<pooler_host>:5432/postgres?ssl=require

DB_POOL_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_SSL_REQUIRED=true

REDIS_URL=redis://localhost:6379/0

# ... Add remaining required keys as needed ...
