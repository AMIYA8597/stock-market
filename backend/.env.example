# NeuroQuant Backend — Environment Configuration
# Copy this to .env and fill in any values you need.
# All OPTIONAL values: the app runs without them.
# See root .env.example for full documentation.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=NeuroQuant
API_V1_PREFIX=/api/v1

# SQLite (no server needed):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SYNC_DATABASE_URL=sqlite:///./dev.db

# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+asyncpg://neuroquant:changeme@localhost:5432/neuroquant_db
# SYNC_DATABASE_URL=postgresql+psycopg2://neuroquant:changeme@localhost:5432/neuroquant_db

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_CACHE_TTL=300
RATE_LIMIT_ENABLED=false

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FIELD_ENCRYPTION_KEY=
ENCRYPTION_ENABLED=false
SECRET_KEY=

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Optional API keys (all free):
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=

# Optional broker keys:
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_CLIENT_SECRET=
ANGEL_ONE_TOTP_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
UPSTOX_MAX_ORDER_VALUE=10000.0

# Email (optional):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@neuroquant.local
ALERT_EMAIL_ENABLED=false

# Payments — Razorpay test mode only:
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

MODEL_CHECKPOINT_DIR=./data/models
ENABLE_GPU=false

# Safety:
LIVE_EXECUTION_CONFIRMED=OFF
PAPER_TRADING_MODE=true
