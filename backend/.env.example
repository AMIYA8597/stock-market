# NeuroQuant Backend — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values for local development.
# NEVER commit .env — it is gitignored.
#
#   cp backend/.env.example backend/.env
#   # then edit backend/.env with real credentials
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
PROJECT_NAME=NeuroQuant
API_V1_PREFIX=/api/v1

# ── Database (Supabase PostgreSQL via Supavisor) ──────────────────────────
# Get from: Supabase dashboard → Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) for asyncpg in async FastAPI:
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Migration URL uses the "Session" pooler (port 5432) or direct connection:
MIGRATIONS_DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
INGEST_DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

DB_POOL_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_SSL_REQUIRED=true

# ── Redis (optional — falls back to in-memory if not set) ────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── Celery ────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_HARD_TIME_LIMIT=900

# ── Supabase / Auth ───────────────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_REGION=ap-northeast-1
SUPABASE_ANON_KEY=eyJhbGci...   # "anon" public key from API settings
SUPABASE_PUBLISHABLE_KEY=sb_publishable_... # Supabase publishable key
SUPABASE_SECRET_KEY=sb_secret_... # "service_role" secret key from API settings
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci... # "service_role" JWT from API settings
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=             # leave blank (uses JWKS from Supabase URL)

TOKEN_BLACKLIST_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── OTP ───────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Password Policy ───────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HASH_ALGORITHM=argon2
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Field Encryption (optional) ───────────────────────────────────────────
ENCRYPTION_ENABLED=false
FIELD_ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://neuroquant-sm.vercel.app
FRONTEND_URL=http://localhost:3000
FRONTEND_PRODUCTION_URL=https://neuroquant-sm.vercel.app
FRONTEND_STAGING_URL=
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-Organization-ID,X-API-Key,Idempotency-Key,Stripe-Signature
# Comma-separated list of allowed Host header values (blank = allow all, set in prod)
ALLOWED_HOSTS=

# ── Security ──────────────────────────────────────────────────────────────
SECURITY_CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ── Email / SendGrid ──────────────────────────────────────────────────────
# Leave SENDGRID_API_KEY blank for local dev — auto-verifies emails without OTP
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=neuroquant990@gmail.com
ALERT_EMAIL_ENABLED=false

# ── Payments / Razorpay ───────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → API Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=10/minute
PREMIUM_RATE_LIMIT=1000/minute

# ── Live Market Data ──────────────────────────────────────────────────────
LIVE_DATA_PROVIDER=upstox
LIVE_DATA_YFINANCE_RATE_LIMIT=5
LIVE_DATA_ALPHA_VANTAGE_RATE_LIMIT=5

# ── Upstox Integration ────────────────────────────────────────────────────
# Get from: https://developer.upstox.com → My Apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
UPSTOX_ENABLED=true
UPSTOX_MAX_ORDER_VALUE=10000.0
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_WS_ENABLED=false
UPSTOX_WS_MODE=full

# ── Angel One SmartAPI ────────────────────────────────────────────────────
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_CLIENT_SECRET=
ANGEL_ONE_TOTP_SECRET=

# ── External Data APIs (all optional — features degrade gracefully) ────────
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=
FINNHUB_API_KEY=

# ── WebSocket ─────────────────────────────────────────────────────────────
WEBSOCKET_URL=ws://localhost:8000/ws
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5

# ── ML / Models ──────────────────────────────────────────────────────────
MODEL_CHECKPOINT_DIR=./data/models
ENABLE_GPU=false
ONLINE_LEARNING_ENABLED=true
DRIFT_DETECTION_ENABLED=true
MAX_TRACKED_SYMBOLS=100
BATCH_SIZE=20
SEQUENCE_LENGTH=60
TRAINING_BATCH_SIZE=64
INFERENCE_BATCH_SIZE=32
FORECAST_HORIZON=5
FEATURE_CACHE_TTL_HOURS=24
FEATURE_NORMALIZATION_METHOD=robust
RETRAIN_MIN_INTERVAL_HOURS=24
RETRAIN_SAMPLE_SIZE=500
DRIFT_DETECTION_ALPHA=0.002

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
ENABLE_PROMETHEUS_METRICS=false
METRICS_COLLECTION_INTERVAL_SECONDS=60
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=neuroquant-prod

# ── Backtest ─────────────────────────────────────────────────────────────
BACKTEST_MAX_WORKERS=4
BACKTEST_CACHE_DIR=./data/backtest_cache
# Trading remains paper-only until a separately approved future phase.
PAPER_TRADING_ONLY=true
LIVE_ORDER_EXECUTION_ENABLED=false
AUTOTRADE_MAX_QUOTE_AGE_SECONDS=120
